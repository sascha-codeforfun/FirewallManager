<!-- Every colour, font and style is a HueTheme token, so the overlay follows the app's family
     and contrast themes with nothing set on the element. Needs HueTheme.xaml merged. -->
<UserControl x:Class="BusyOverlayKit.BusyOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:busy="clr-namespace:BusyOverlayKit"
             Visibility="Collapsed"
             Panel.ZIndex="1000">

    <UserControl.Resources>
        <!-- Opposite directions, unequal periods: the rings never read as one shape. Slow on
             purpose: nothing else on screen moves, so a fast spin would be the loudest thing. -->
        <Storyboard x:Key="BusySpin" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinOuter"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:2.6" />
            <DoubleAnimation Storyboard.TargetName="SpinInner"
                             Storyboard.TargetProperty="Angle"
                             From="360" To="0" Duration="0:0:1.9" />
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <!-- Blocks input to everything underneath. -->
        <Rectangle Fill="{DynamicResource Busy.Scrim}" />

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">

            <Viewbox Width="{Binding MarkSize, RelativeSource={RelativeSource AncestorType={x:Type busy:BusyOverlay}}}"
                     Height="{Binding MarkSize, RelativeSource={RelativeSource AncestorType={x:Type busy:BusyOverlay}}}"
                     HorizontalAlignment="Center">
                <!-- 256x256, centre 128,128; outer arc r=86, inner r=52. The dots sit on the arc
                     ends by hand: change a radius and recompute both, or a dot detaches. -->
                <Canvas Width="256" Height="256">

                    <Canvas Width="256" Height="256" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="SpinOuter" />
                        </Canvas.RenderTransform>

                        <Path Data="M183.28,62.12 A86,86 0 1 1 47.19,98.59"
                              Stroke="{DynamicResource Brush.Glow}"
                              StrokeThickness="13" Opacity="0.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                            <Path.Effect><BlurEffect Radius="9" /></Path.Effect>
                        </Path>

                        <Path Data="M183.28,62.12 A86,86 0 1 1 47.19,98.59"
                              Stroke="{DynamicResource Busy.Ring}"
                              StrokeThickness="13"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                        <Ellipse Canvas.Left="40.69" Canvas.Top="92.09" Width="13" Height="13"
                                 Fill="{DynamicResource Brush.Glow}" />
                    </Canvas>

                    <Canvas Width="256" Height="256" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="SpinInner" />
                        </Canvas.RenderTransform>

                        <Path Data="M82.97,154 A52,52 0 0 1 173.03,102"
                              Stroke="{DynamicResource Brush.Glow}"
                              StrokeThickness="11" Opacity="0.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                            <Path.Effect><BlurEffect Radius="9" /></Path.Effect>
                        </Path>

                        <Path Data="M82.97,154 A52,52 0 0 1 173.03,102"
                              Stroke="{DynamicResource Busy.RingAccent}"
                              StrokeThickness="11"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />

                        <Ellipse Canvas.Left="167.53" Canvas.Top="96.5" Width="11" Height="11"
                                 Fill="{DynamicResource Brush.Glow}" />
                    </Canvas>

                </Canvas>
            </Viewbox>

            <!-- Trimmed, not wrapped: a wrapping path would make the layout jump. -->
            <TextBlock x:Name="TitleText" Margin="0,22,0,0" MaxWidth="520"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       FontSize="15" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Brush.Text}" />

            <TextBlock x:Name="DetailText" Margin="0,7,0,0" MaxWidth="520"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       FontSize="11.5" TextTrimming="CharacterEllipsis"
                       FontFamily="{DynamicResource Font.Mono}"
                       Foreground="{DynamicResource Brush.TextDim}" />

            <!-- Appears with the first real position and stays, so it never flickers. -->
            <ProgressBar x:Name="Bar" Height="4" Width="320" Margin="0,18,0,0"
                         Visibility="Collapsed" BorderThickness="0"
                         Background="{DynamicResource Brush.Raised}"
                         Foreground="{DynamicResource Brush.Accent}" />

            <!-- Only when the work honours its token: a button that declines is worse than none. -->
            <Button x:Name="CancelButton" Content="Cancel" Margin="0,22,0,0"
                    MinWidth="96" HorizontalAlignment="Center"
                    Visibility="Collapsed"
                    Style="{DynamicResource Hue.Button}"
                    Click="OnCancelClick" />

        </StackPanel>
    </Grid>
</UserControl>

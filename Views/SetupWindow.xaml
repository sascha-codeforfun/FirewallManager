<Window x:Class="FirewallManager.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:busy="clr-namespace:BusyOverlayKit"
        Style="{StaticResource Hue.Window}"
        Title="Setup" Height="760" Width="1040" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner">

    <!-- Setup: rules for the things you set up on purpose, one recipe per button. Everything
         else (what programs try on their own) goes through the log: Live, Talkers, Allow…
         Every recipe writes one GPO-Script rule per machine or program, named SERVICE-LAST
         (RDP-51, SMB-22-IN), which you can change before creating it. -->
    <Window.Resources>
        <Style x:Key="RecipeTile" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="MinHeight" Value="58"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="110"/>
        </Style>
        <Style x:Key="GroupLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Section}">
            <Setter Property="Margin" Value="2,10,0,6"/>
        </Style>
        <!-- Under a field: what was taken out of it, and the plain alternatives (set from code). -->
        <Style x:Key="HygieneNote" TargetType="StackPanel">
            <Setter Property="Margin" Value="110,4,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Window.Resources>

    <!-- The overlay covers the whole window while a Remote Desktop rule is applied with the
         failsafe; the content beneath takes no input meanwhile (set from code). -->
    <Grid x:Name="SetupRoot">
        <Grid x:Name="SetupContent" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Setup" Style="{StaticResource Text.Heading}"/>
                <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Rules for the things you set up on purpose. What programs try on their own shows up in the Connection Log — allow it from there."/>
                <TextBlock x:Name="NetInfo" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- The recipes: big buttons, one open at a time -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                    <StackPanel x:Name="TilePanel">
                        <TextBlock Text="YOUR NETWORK" Style="{StaticResource GroupLabel}" Margin="2,0,0,6"/>
                        <ToggleButton x:Name="TileRdpOut"  Tag="rdp-out"  Style="{StaticResource RecipeTile}" Click="Tile_Click"/>
                        <ToggleButton x:Name="TileRdpIn"   Tag="rdp-in"   Style="{StaticResource RecipeTile}" Click="Tile_Click"/>
                        <ToggleButton x:Name="TileSmbOut"  Tag="smb-out"  Style="{StaticResource RecipeTile}" Click="Tile_Click"/>
                        <ToggleButton x:Name="TileSmbIn"   Tag="smb-in"   Style="{StaticResource RecipeTile}" Click="Tile_Click"/>
                        <ToggleButton x:Name="TileNtp"     Tag="ntp"      Style="{StaticResource RecipeTile}" Click="Tile_Click"/>
                        <TextBlock Text="PROGRAMS" Style="{StaticResource GroupLabel}"/>
                        <ToggleButton x:Name="TileBrowser" Tag="browsers" Style="{StaticResource RecipeTile}" Click="Tile_Click"/>
                        <TextBlock Text="SERVICES ON THE INTERNET" Style="{StaticResource GroupLabel}"/>
                        <ToggleButton x:Name="TileClaude"  Tag="claude"   Style="{StaticResource RecipeTile}" Click="Tile_Click"/>
                        <ToggleButton x:Name="TileGitHub"  Tag="github"   Style="{StaticResource RecipeTile}" Click="Tile_Click"/>
                        <ToggleButton x:Name="TileNuGet"   Tag="nuget"    Style="{StaticResource RecipeTile}" Click="Tile_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- The open recipe -->
                <Border Grid.Column="1" Style="{StaticResource Hue.Card}" Padding="22,18">
                    <Grid>
                        <!-- Nothing chosen yet -->
                        <TextBlock x:Name="PickHint" Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Text="Choose what to set up on the left."/>

                        <ScrollViewer x:Name="RecipePanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="RecipeTitle" Style="{StaticResource Text.Heading}"/>
                                <TextBlock x:Name="RecipeText" Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                                           Margin="0,6,0,16"/>

                                <!-- One machine: address, pre-filled with this network ("192.168.7.") -->
                                <StackPanel x:Name="AddressPanel" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="AddressLabel" Text="Address" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtAddress" Width="200" TextChanged="Address_TextChanged"
                                                 ToolTip="One IPv4 address: four numbers, each 0–255; plain ASCII. One machine per rule."/>
                                        <TextBlock x:Name="AddressHint" Style="{StaticResource Text.Caption}" Margin="12,0,0,0"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380"/>
                                    </StackPanel>
                                    <StackPanel x:Name="AddressNote" Style="{StaticResource HygieneNote}"/>
                                </StackPanel>

                                <!-- Remote Desktop's port: typed for outgoing, this machine's setting for incoming -->
                                <StackPanel x:Name="PortPanel" Margin="0,0,0,10" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtPort" Width="200" TextChanged="Port_TextChanged"
                                                 ToolTip="1–65535 and ranges a-b, comma-separated; plain ASCII."/>
                                        <TextBlock x:Name="PortValue" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Text}"/>
                                        <TextBlock x:Name="PortHint" Style="{StaticResource Text.Caption}" Margin="12,0,0,0"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="380"/>
                                    </StackPanel>
                                    <StackPanel x:Name="PortNote" Style="{StaticResource HygieneNote}"/>
                                </StackPanel>

                                <!-- Remote Desktop on this machine (incoming only) -->
                                <ContentControl x:Name="RdpState" Style="{StaticResource Hue.Callout}" Margin="0,0,0,12"
                                                Visibility="Collapsed">
                                    <DockPanel LastChildFill="True">
                                        <Button x:Name="BtnEnableRdp" DockPanel.Dock="Right" Content="Turn on Remote Desktop"
                                                Style="{StaticResource Hue.Button.Tonal}" Margin="12,0,0,0"
                                                VerticalAlignment="Center" Click="BtnEnableRdp_Click"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="RdpStateTitle" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="RdpStateText" Foreground="{DynamicResource Brush.TextDim}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </ContentControl>

                                <!-- Browsers: what's installed, you pick; Custom… for anything else -->
                                <StackPanel x:Name="BrowserPanel" Visibility="Collapsed" Margin="0,0,0,10">
                                    <ItemsControl x:Name="BrowserList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="170"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center"
                                                              Checked="Browser_Changed" Unchecked="Browser_Changed"/>
                                                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                             Margin="8,0,12,0" Loaded="BrowserName_Loaded"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Path}" ToolTip="{Binding Path}"
                                                               Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <!-- What was taken out of the name (set from code) -->
                                                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                                Margin="8,4,0,0" Visibility="Collapsed"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="NoBrowsers" Style="{StaticResource Text.Caption}" Margin="0,0,0,8"
                                               Visibility="Collapsed" Text="No Edge, Chrome or Firefox found in the usual places."/>
                                    <Button Content="Custom…" HorizontalAlignment="Left" Click="BtnCustomBrowser_Click"
                                            ToolTip="Pick any browser's .exe, e.g. a portable Firefox"/>
                                </StackPanel>

                                <!-- Services on the internet: the addresses the rule will use -->
                                <StackPanel x:Name="FixedPanel" Visibility="Collapsed" Margin="0,0,0,10">
                                    <StackPanel x:Name="AddressesRow" Orientation="Horizontal">
                                        <TextBlock Text="Addresses" Style="{StaticResource FieldLabel}" VerticalAlignment="Top"/>
                                        <TextBlock x:Name="FixedAddresses" TextWrapping="Wrap" MaxWidth="480"
                                                   Foreground="{DynamicResource Brush.Text}"/>
                                    </StackPanel>

                                    <!-- Claude: the published range or one looked-up address; nothing chosen until you choose -->
                                    <StackPanel x:Name="ClaudePanel" Visibility="Collapsed">
                                        <TextBlock Text="Choose one" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                        <RadioButton x:Name="RbClaudeRange" GroupName="ClaudeChoice" Checked="ClaudeChoice_Checked">
                                            <StackPanel>
                                                <TextBlock x:Name="ClaudeRangeText" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="ClaudeRangeSource" Style="{StaticResource Text.Caption}"
                                                           TextWrapping="Wrap" MaxWidth="480" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <TextBlock x:Name="ClaudeLookupHead" Style="{StaticResource Text.Caption}" Margin="0,12,0,4"
                                                   TextWrapping="Wrap" MaxWidth="480"/>
                                        <StackPanel x:Name="ClaudeLookupList"/>
                                    </StackPanel>

                                    <ContentControl x:Name="LookupNote" Style="{StaticResource Hue.Callout.Warn}" Margin="0,10,0,0"
                                                    Visibility="Collapsed">
                                        <TextBlock x:Name="LookupText" TextWrapping="Wrap"/>
                                    </ContentControl>
                                    <ContentControl x:Name="DriftNote" Style="{StaticResource Hue.Callout.Warn}" Margin="0,10,0,0"
                                                    Visibility="Collapsed">
                                        <TextBlock x:Name="DriftText" TextWrapping="Wrap"/>
                                    </ContentControl>
                                </StackPanel>

                                <!-- Rule name (single-rule recipes): SERVICE-LAST, yours to change -->
                                <StackPanel x:Name="NamePanel" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Rule name" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="TxtRuleName" Width="200" TextChanged="RuleName_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel x:Name="NameNote" Style="{StaticResource HygieneNote}"/>
                                </StackPanel>

                                <!-- What it will do, in one sentence per rule -->
                                <ContentControl x:Name="Preview" Style="{StaticResource Hue.Callout}" Margin="0,0,0,10">
                                    <TextBlock x:Name="PreviewText" TextWrapping="Wrap"/>
                                </ContentControl>
                                <ContentControl x:Name="ExistingNote" Style="{StaticResource Hue.Callout.Warn}" Margin="0,0,0,10"
                                                Visibility="Collapsed">
                                    <TextBlock x:Name="ExistingText" TextWrapping="Wrap"/>
                                </ContentControl>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button x:Name="BtnCreate" Content="Create rule" Style="{StaticResource Hue.Button.Primary}"
                                            Click="BtnCreate_Click" MinWidth="140"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="True">
                <Button DockPanel.Dock="Right" x:Name="BtnClose" Content="Close" Click="BtnClose_Click" MinWidth="100"/>
                <Button DockPanel.Dock="Right" Content="Export config.json template" Style="{StaticResource Hue.Button.Ghost}"
                        Margin="0,0,10,0" Click="BtnExportJson_Click"
                        ToolTip="Write the app's knowledge (noise, service ranges, org-tags, encrypted-DNS servers) to an editable config.json"/>
                <Border x:Name="SetupStatusFrame" CornerRadius="4" Padding="8,4" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SetupStatus" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </Border>
            </DockPanel>
        </Grid>

        <busy:BusyOverlay x:Name="Busy" AnimateOverride="True"/>
    </Grid>
</Window>

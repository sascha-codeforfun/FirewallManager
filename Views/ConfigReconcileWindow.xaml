<Window x:Class="FirewallManager.ConfigReconcileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Hue.Window}"
        Title="config.json differs from built-in defaults"
        Width="720" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Border Padding="24,20">
        <StackPanel>
            <TextBlock Text="config.json differs from the built-in defaults" Style="{StaticResource Text.Heading}"/>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource Text.Body}" Margin="0,6,0,0"
                       Text="For each section below, choose which to use. The built-in defaults are the trusted baseline; the config file is your editable override. You'll only be asked again if config.json changes."/>

            <StackPanel x:Name="SectionsPanel" Margin="0,16,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="BtnKeepAll" Content="Keep all built-in" Click="BtnKeepAll_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnOk" Content="Apply choices" Click="BtnOk_Click"
                        Style="{StaticResource Hue.Button.Primary}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

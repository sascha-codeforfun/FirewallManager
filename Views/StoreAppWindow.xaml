<Window x:Class="FirewallManager.StoreAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Hue.Window}"
        Title="Store app" Height="520" Width="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Store apps a rule can match" Style="{StaticResource Text.Heading}"/>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                       Text="Desktop apps installed from the Store, with the program each one starts. A Store app's folder changes with every update; Update in the editor follows it. Sandboxed Store apps (Calculator and the like) aren't listed: Windows matches those by their package, so a rule by path wouldn't apply to them."/>
        </StackPanel>

        <ListBox x:Name="AppList" Grid.Row="1" SelectionMode="Single" MouseDoubleClick="AppList_DoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Exe}" Style="{StaticResource Text.Mono}" FontSize="11"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="Reading" Grid.Row="1" Text="Reading the installed Store apps…" Style="{StaticResource Text.Caption}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Click="BtnCancel_Click" Margin="0,0,8,0"/>
            <Button x:Name="BtnSelect" Content="Select" Style="{StaticResource Hue.Button.Primary}" Click="BtnSelect_Click" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>

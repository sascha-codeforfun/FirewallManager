<Window x:Class="FirewallManager.ExePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Hue.Window}"
        Title="Select Executable" Height="380" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Multiple matches found" Style="{StaticResource Text.Heading}"/>
            <TextBlock Text="Sub-path matches are shown first (★). Select the correct executable:"
                       Style="{StaticResource Text.Caption}" Margin="0,4,0,0"/>
        </StackPanel>

        <ListBox x:Name="PathList" Grid.Row="1" SelectionMode="Single"
                 MouseDoubleClick="PathList_DoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,3">
                        <TextBlock x:Name="Name" Text="{Binding Display}" FontWeight="{Binding Weight}"/>
                        <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Mono}" FontSize="11"/>
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <!-- The likely match reads in the accent text colour; the ★ says it in words. -->
                        <DataTrigger Binding="{Binding IsBest}" Value="True">
                            <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource Brush.AccentText}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Click="BtnCancel_Click" Margin="0,0,8,0"/>
            <Button Content="Select" Style="{StaticResource Hue.Button.Primary}" Click="BtnSelect_Click"/>
        </StackPanel>
    </Grid>
</Window>

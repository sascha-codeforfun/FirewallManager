<Window x:Class="FirewallManager.RuleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FirewallManager"
        xmlns:busy="clr-namespace:BusyOverlayKit"
        Style="{StaticResource Hue.Window}"
        Title="{Binding Text, ElementName=TitleText}" Width="1080" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Window.Resources>
        <!-- Layout-only styles; colours and templates come from HueTheme. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="110"/>
        </Style>
        <!-- The theme's 0.55 on a disabled box left an empty one (Port(s) with ICMP) looking like an
             empty field to fill: this takes it to about 0.4 overall, still legible. Not on the address
             box, whose section dims as a whole already. -->
        <Style x:Key="FieldBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.75"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BtnAction" TargetType="Button" BasedOn="{StaticResource Hue.Button}"/>
        <!-- Removable address entries ("10.0.0.0/24  ✕"): a theme button, click removes. -->
        <Style x:Key="TagBtn" TargetType="Button" BasedOn="{StaticResource Hue.Button}">
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style x:Key="ToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource Hue.Switch}"/>
        <!-- Service preset chip: the theme's ToggleButton (accent edge + tint when on),
             44 epx tall to meet the 44pt touch-target minimum; as wide as the Presets box. -->
        <Style x:Key="PresetChip" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <!-- A preset matched in the other direction than its own: amber, as "In" in the rule list. -->
        <Style x:Key="PresetChipOtherWay" TargetType="ToggleButton" BasedOn="{StaticResource PresetChip}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush.WarnText}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warn}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Under a field: what was taken out of it, and the plain alternatives (set from code). -->
        <Style x:Key="HygieneNote" TargetType="StackPanel">
            <Setter Property="Margin" Value="110,4,0,0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Window.Resources>

    <!-- Root holds the form and the overlay the session guard runs under (Save of an existing rule). -->
    <Grid x:Name="Root">
    <Grid x:Name="Form" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock x:Name="TitleText" Text="Edit Rule" Style="{StaticResource Text.Heading}"
                       VerticalAlignment="Center"/>
            <ContentControl x:Name="SourceBadge" Style="{StaticResource Hue.Tag}" Margin="12,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Path x:Name="SourceLock" Style="{StaticResource Hue.Icon}" Data="{StaticResource Icon.Lock}"
                          Margin="0,0,5,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="SourceLabel" VerticalAlignment="Center"/>
                </StackPanel>
            </ContentControl>
            <TextBlock x:Name="ReadOnlyLabel" Text="  (read-only)" Foreground="{DynamicResource Brush.TextMuted}"
                       FontSize="12" VerticalAlignment="Center" Visibility="Collapsed"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Fields -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Filled in from observed traffic ("Allow…" in the log's Talkers tab): says what
                         it was based on. Nothing is saved until Save. -->
                    <ContentControl x:Name="PrefillNote" Style="{StaticResource Hue.Callout}"
                                    Visibility="Collapsed" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock x:Name="PrefillTitle" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PrefillDetail" Foreground="{DynamicResource Brush.TextDim}"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </ContentControl>

                    <!-- A rule carrying settings the editor doesn't write: names them (set from code). -->
                    <ContentControl x:Name="ForeignNote" Style="{StaticResource Hue.Callout}"
                                    Visibility="Collapsed" Margin="0,0,0,14">
                        <TextBlock x:Name="ForeignDetail" TextWrapping="Wrap"/>
                    </ContentControl>

                    <!-- Name -->
                    <StackPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtName" Width="360" Style="{StaticResource FieldBox}"/>
                        </StackPanel>
                        <StackPanel x:Name="NameNote" Style="{StaticResource HygieneNote}"/>
                    </StackPanel>

                    <!-- Direction + Action -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Direction" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CboDirection" Width="120" Margin="0,0,12,0">
                            <ComboBoxItem Content="In"/>
                            <ComboBoxItem Content="Out"/>
                        </ComboBox>
                        <TextBlock Text="Action" Style="{StaticResource FieldLabel}" Width="60"/>
                        <ComboBox x:Name="CboAction" Width="120">
                            <ComboBoxItem Content="Allow"/>
                            <ComboBoxItem Content="Block"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Protocol + Ports -->
                    <StackPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Protocol" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CboProtocol" Width="120" Margin="0,0,12,0">
                                <ComboBoxItem Content="TCP"/>
                                <ComboBoxItem Content="UDP"/>
                                <ComboBoxItem Content="ICMP"/>
                                <ComboBoxItem Content="ICMPv6"/>
                                <ComboBoxItem Content="Any"/>
                            </ComboBox>
                            <TextBlock Text="Port(s)" Style="{StaticResource FieldLabel}" Width="60"/>
                            <TextBox x:Name="TxtPorts" Width="160" Style="{StaticResource FieldBox}" ToolTipService.ShowOnDisabled="True" ToolTip="One port, several separated by commas, or a range: 443 · 80,443 · 1000-2000 (TCP or UDP only)&#x0a;1–65535 and ranges a-b, comma-separated; plain ASCII."/>
                        </StackPanel>
                        <StackPanel x:Name="PortsNote" Style="{StaticResource HygieneNote}"/>
                    </StackPanel>

                    <!-- Local Address: this machine's own address the rule applies to. -->
                    <StackPanel Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Local Address" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtLocalAddress" Width="220" Style="{StaticResource FieldBox}"
                                     ToolTip="This machine's own address the rule applies to: an IPv4 address, a range a-b, or a subnet a/n or a/mask; several with commas. Empty = any of its addresses.&#x0a;IPv4 address, range a-b, subnet a/n or a/mask, comma-separated; plain ASCII. /0 is refused: Windows won't load it."/>
                            <TextBlock Text="empty = any address of this machine" Foreground="{DynamicResource Brush.TextMuted}"
                                       FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="LocalNote" Style="{StaticResource HygieneNote}"/>
                    </StackPanel>

                    <!-- Remote Address -->
                    <StackPanel Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Remote Address" Style="{StaticResource FieldLabel}"/>
                            <ToggleButton x:Name="TogLimit" Style="{StaticResource ToggleStyle}"
                                          Checked="TogLimit_Checked" Unchecked="TogLimit_Unchecked"/>
                            <TextBlock x:Name="AnyLabel" Text="Any destination" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11"
                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- IP tag list -->
                        <Border x:Name="IPSection" Background="{DynamicResource Brush.Surface}" CornerRadius="{StaticResource Radius.Control}"
                                Padding="8" Margin="110,0,0,0" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                                Width="440" HorizontalAlignment="Left">
                            <StackPanel>
                                <WrapPanel x:Name="IPTagPanel" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="TxtNewIP" Width="220"
                                             ToolTip="An IPv4 address (10.0.0.5), a range a-b (10.0.0.1-10.0.0.9), or a subnet a/n or a/mask (10.0.0.0/24, 10.0.0.0/255.255.255.0); several with commas.&#x0a;IPv4 address, range a-b, subnet a/n or a/mask, comma-separated; plain ASCII. /0 is refused: Windows won't load it."/>
                                    <Button Content="+ Add" Margin="6,0,0,0" Click="BtnAddIP_Click"
                                            Style="{StaticResource Hue.Button.Tonal}"/>
                                </StackPanel>
                                <StackPanel x:Name="RemoteNote" Style="{StaticResource HygieneNote}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- DNS preset only: the one resolver the rule allows, from the configuration's
                             dnsPresets. One address on purpose: every answer then has one known source. -->
                        <StackPanel x:Name="DnsResolverRow" Orientation="Horizontal" Margin="110,8,0,0" Visibility="Collapsed">
                            <TextBlock Text="Resolver" Foreground="{DynamicResource Brush.TextDim}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CboResolver" Width="280" DisplayMemberPath="Label"
                                      SelectionChanged="CboResolver_SelectionChanged"
                                      ToolTip="The one DNS server this rule allows. One on purpose: every answer in the log then has one known source."/>
                        </StackPanel>
                        <!-- Warning for wide-open rules (set from code: UpdateOpenNote) -->
                        <ContentControl x:Name="OpenNote" Style="{StaticResource Hue.Callout.Warn}"
                                        Visibility="Collapsed" Margin="110,8,0,0">
                            <StackPanel>
                                <TextBlock x:Name="OpenNoteTitle" FontWeight="SemiBold"/>
                                <TextBlock x:Name="OpenNoteDetail" Foreground="{DynamicResource Brush.TextDim}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>

                    <!-- Program -->
                    <StackPanel Margin="0,10,0,6">
                        <!-- The path box takes the row's full width: program paths (Defender's platform
                             folder, WindowsApps) run to 90–120+ characters. The tooltip shows the whole
                             path when even that isn't enough. -->
                        <DockPanel Margin="0,0,0,6" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="Program" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtProgram">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
                                        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="ToolTip" Value="Full path to .exe or leave empty for any process"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </DockPanel>
                        <!-- The ways to fill the path, in a row of their own so the path box keeps the
                             whole width. -->
                        <WrapPanel x:Name="ProgramButtons" Orientation="Horizontal" Margin="110,0,0,0">
                            <Button x:Name="BtnBrowseExe" Content="…" Margin="0,0,6,6" Click="BtnBrowseExe_Click"
                                    Style="{StaticResource BtnAction}" ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Browse for the program"/>
                            <Button x:Name="BtnUpdateLocation" local:IconText.Icon="Icon.Refresh" local:IconText.Text="Update" Margin="0,0,6,6" Click="BtnUpdateLocation_Click"
                                    Style="{StaticResource BtnAction}" ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Find the program again after an update moved it (a Store app's versioned folder)"/>
                            <Button x:Name="BtnService" local:IconText.Icon="Icon.Settings" local:IconText.Text="Service" Margin="0,0,6,6" Click="BtnService_Click"
                                    Style="{StaticResource BtnAction}" ToolTipService.ShowOnDisabled="True"
                                    ToolTip="A rule for one Windows service: fills in svchost.exe and opens the list of services"/>
                            <Button x:Name="BtnStoreApp" local:IconText.Icon="Icon.Search" local:IconText.Text="Store app…" Margin="0,0,6,6" Click="BtnStoreApp_Click"
                                    Style="{StaticResource BtnAction}" ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Pick an installed Store app: fills in the program it starts"/>
                            <Button x:Name="BtnPin" local:IconText.Icon="Icon.Fingerprint" local:IconText.Text="Pin" Margin="0,0,6,6" Click="BtnPin_Click" Visibility="Collapsed"
                                    Style="{StaticResource BtnAction}" ToolTipService.ShowOnDisabled="True"
                                    ToolTip="Pin this file by its exact content (SHA-256): the rules list then shows when it changes"/>
                        </WrapPanel>
                        <!-- What is known about the file: signer, look-alike, pin, Store app. Coloured as
                             in the rules list. -->
                        <TextBlock x:Name="ProgramNote" Margin="110,0,0,4" TextWrapping="Wrap" FontSize="12"
                                   Visibility="Collapsed"/>
                        <!-- Service: only for svchost.exe, which hosts many services. Scopes the rule to
                             one of them (Svc=…), the way Windows' own Remote Desktop rule does. -->
                        <StackPanel x:Name="ServiceRow" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                            <TextBlock Text="Service" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CboService" Width="500" IsEditable="True" TextSearch.TextPath="Name"
                                      ToolTip="The service inside svchost.exe this rule is for. Empty = every service in every svchost.">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding Display, Mode=OneWay}" Foreground="{DynamicResource Brush.TextMuted}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <!-- Active -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Active" Style="{StaticResource FieldLabel}"/>
                        <ToggleButton x:Name="TogActive" Style="{StaticResource ToggleStyle}" IsChecked="True"/>
                        <TextBlock x:Name="ActiveLabel" Text="Enabled" Foreground="{DynamicResource Brush.TextDim}"
                                   FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Validation message -->
                    <TextBlock x:Name="ValidationMsg" Foreground="{DynamicResource Brush.ErrorText}" FontSize="11"
                               Margin="110,0,0,0" Visibility="Collapsed"/>

                </StackPanel>
            </ScrollViewer>

            <!-- Presets: each fills the form for one known use; the one the form matches lights up.
                 Hidden where the rule can't be changed. Chips built in code. -->
            <Border x:Name="PresetBox" Grid.Column="1" Style="{StaticResource Hue.Card}" Width="204"
                    Margin="16,0,0,0" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PRESETS" Style="{StaticResource Text.Section}" Margin="2,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PresetPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="EditStatus" Foreground="{DynamicResource Brush.TextMuted}" FontSize="11" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,12,0"/>
            <Button Grid.Column="1" x:Name="BtnSave" local:IconText.Icon="Icon.Save" local:IconText.Text="Save"
                    Style="{StaticResource Hue.Button.Primary}" Margin="0,0,8,0" Click="BtnSave_Click"/>
            <Button Grid.Column="2" Content="Cancel"
                    Style="{StaticResource BtnAction}" Click="BtnCancel_Click"/>
        </Grid>
    </Grid>
        <busy:BusyOverlay x:Name="Busy" AnimateOverride="True"/>
    </Grid>
</Window>

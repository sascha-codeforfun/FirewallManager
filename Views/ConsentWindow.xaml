<Window x:Class="FirewallManager.ConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource Hue.Window}"
        Title="ἸΔΙΩΤΗΣ" Width="600"
        SizeToContent="Height" MinHeight="620"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Border Padding="34,28">
        <StackPanel>

            <!-- Impossible-value rejection banner (hidden in normal/first-run) -->
            <ContentControl x:Name="RejectBanner" Visibility="Collapsed"
                            Style="{StaticResource Hue.Callout.Critical}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Impossible value rejected" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                    <TextBlock x:Name="RejectText" Style="{StaticResource Text.Mono}" TextWrapping="Wrap"/>
                    <TextBlock Text="These could not represent any real address. The section was left at its built-in baseline. Fix config.json — μηδεὶς ἀδαὴς εἰσίτω."
                               Foreground="{DynamicResource Brush.TextDim}" FontSize="12" FontStyle="Italic"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </ContentControl>

            <!-- ── Greek gate ── (the serif face is deliberate: an inscription, not UI text) -->
            <TextBlock Text="ἸΔΙΩΤΗΣ" FontSize="40" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.AccentText}" HorizontalAlignment="Center"
                       FontFamily="Palatino Linotype, Cambria, Georgia, serif"/>
            <TextBlock Text="μηδεὶς ἀδαὴς εἰσίτω" FontSize="20"
                       Foreground="{DynamicResource Brush.TextDim}" HorizontalAlignment="Center" Margin="0,6,0,2"
                       FontFamily="Palatino Linotype, Cambria, Georgia, serif"/>
            <TextBlock Text="let none unknowing enter" FontStyle="Italic" HorizontalAlignment="Center"
                       Style="{StaticResource Text.Caption}" Margin="0,0,0,18"/>

            <Border Height="1" Background="{DynamicResource Brush.LineSoft}" Margin="0,0,0,18"/>

            <!-- ── English contract ── -->
            <TextBlock Style="{StaticResource Text.Body}" LineHeight="20" Margin="0,0,0,12">
                <Run FontStyle="Italic">idiōtēs</Run>
                <Run Foreground="{DynamicResource Brush.TextMuted}">(ἰδιώτης) — Greek: the layman; one who does not possess the knowledge of the craft.</Run>
            </TextBlock>

            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8">
                This is a power tool for people who know what they are doing. Not a managed, guard-railed product.
            </TextBlock>

            <TextBlock Style="{StaticResource Text.Body}" LineHeight="20" Margin="0,0,0,12">
                It writes Windows Firewall policy directly to the registry, deletes and toggles rules, forces
                Group Policy refresh, and can disable name resolution. It can <Run FontWeight="Bold" Foreground="{DynamicResource Brush.ErrorText}">sever
                this machine's network</Run>, <Run FontWeight="Bold" Foreground="{DynamicResource Brush.ErrorText}">lock you out of the RDP session you
                are using right now</Run> with no remote way back, and break DNS, updates, or LAN access. Recovery may
                require physical or console access. It does exactly what you tell it — including the harmful thing.
                <Run FontWeight="Bold" Foreground="{DynamicResource Brush.WarnText}">Test in a VM first.</Run>
            </TextBlock>

            <TextBlock Style="{StaticResource Text.Body}" FontStyle="Italic" Margin="0,0,0,18">
                I warn you, not that you will listen — it is your funeral, not mine.
            </TextBlock>

            <Border Height="1" Background="{DynamicResource Brush.LineSoft}" Margin="0,0,0,16"/>

            <!-- ── Oaths ── -->
            <CheckBox x:Name="ChkNotIdiotes" Margin="0,0,0,10"
                      Checked="Chk_Changed" Unchecked="Chk_Changed">
                <TextBlock TextWrapping="Wrap">I am no <Run FontStyle="Italic">idiōtēs</Run>.</TextBlock>
            </CheckBox>

            <CheckBox x:Name="ChkResponsibility" Margin="0,0,0,20"
                      Checked="Chk_Changed" Unchecked="Chk_Changed">
                <TextBlock TextWrapping="Wrap" Width="470">I know what I am doing, I have console / out-of-band
                    access or accept the risk of lockout, and I accept full responsibility.</TextBlock>
            </CheckBox>

            <!-- ── Buttons ── -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnDecline" Content="Leave" Click="BtnDecline_Click" Margin="0,0,10,0"/>
                <Button x:Name="BtnProceed" Content="Proceed" Click="BtnProceed_Click"
                        IsEnabled="False" Style="{StaticResource Hue.Button.Primary}"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
